GROQ_API_KEY="your_groq_api_key"
TAVILY_API_KEY="your_tavily_api_key"
AVIATION_STACK_API_KEY="your_aviationstack_api_key"
# Compatibility alias also accepted: AVIATIONSTACK_API_KEY
OPENWEATHER_API_KEY="your_openweather_api_key"
# Set this in Render from Neon; never commit the real value.
DATABASE_URL="<paste-Neon-PostgreSQL-URL-with-sslmode-require>"
DEFAULT_ORIGIN_IATA="DEL"
PROVIDER_TRANSPORT="direct"

# Session-bound approved exports and small-deployment safeguards.
# Use a long random value in production; changing it invalidates existing browser sessions.
SESSION_SIGNING_SECRET="<generate-a-long-random-secret-locally>"
MAX_CONCURRENT_TRIPS="2"
SESSION_REQUEST_LIMIT="8"
SESSION_REQUEST_WINDOW_SECONDS="3600"
# Keep false for the first Neon deployment; set true only after persistence verification.
REQUIRE_PERSISTENT_STORAGE="false"

# Model IDs — Groq free-tier (env-overridable; no code change needed to swap models)
GROQ_CONTROL_MODEL="openai/gpt-oss-20b"
GROQ_GENERATION_MODEL="openai/gpt-oss-120b"

# GPT-OSS reasoning settings
LLM_REASONING_EFFORT="low"
LLM_REASONING_FORMAT="hidden"

LANGSMITH_TRACING="false"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your_langsmith_api_key"
LANGSMITH_PROJECT="TripBandhu"
# LANGSMITH_WORKSPACE_ID="your_workspace_id"
